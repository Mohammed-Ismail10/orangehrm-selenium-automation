<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM Suite"
       parallel="tests"
       thread-count="3">

    <listeners>
        <listener class-name="org.example.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- ==================== SMOKE ==================== -->

    <test name="Chrome Smoke">
        <parameter name="browser" value="chrome"/>
        <parameter name="username" value="Admin"/>
        <parameter name="password" value="admin123"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
<!--            <class name="org.example.tests.LoginTest"/>-->
            <class name="org.example.tests.DashboardTest"/>
        </classes>
    </test>

    <test name="Firefox Smoke">
        <parameter name="browser" value="firefox"/>
        <parameter name="username" value="Admin"/>
        <parameter name="password" value="admin123"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
<!--            <class name="org.example.tests.LoginTest"/>-->
            <class name="org.example.tests.DashboardTest"/>
        </classes>
    </test>

    <test name="Edge Smoke">
        <parameter name="browser" value="edge"/>
        <parameter name="username" value="Admin"/>
        <parameter name="password" value="admin123"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
<!--            <class name="org.example.tests.LoginTest"/>-->
            <class name="org.example.tests.DashboardTest"/>
        </classes>
    </test>

</suite>